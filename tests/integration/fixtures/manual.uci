config settings 'main'
	option enabled 'true'
	option ipv6 'selective'
	list wan_device 'wan'
	list wan_device 'wan2'
	list exempt_ip '10.2.0.3'
	list exempt_ip 'fd00:2::3'

config service 'integration'
	option enabled 'yes'
	list ip '10.2.0.0/30'
	list ip '10.2.0.2'
	list ip '10.3.0.2'
	list ip 'fd00:2::/126'
	list ip 'fd00:2::2'
	list ip 'fd00:3::2'
